# Copy this file to .env.local and fill in real values before deploying.

# Required in production. Signs the client-workspace and admin session cookies.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Required. Client records + media metadata database.
# Supabase project -> Project Settings -> API -> Project URL / service_role (secret) key.
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Required. Cloudinary account -> dashboard homepage for all three values.
# Used to store client photo/video deliverables.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Required. Password for the /admin dashboard (separate from client passwords).
# A `salt:hash` string from: node scripts/hash-password.mjs "the admin password"
ADMIN_PASSWORD_HASH=

# Optional. Without it, quote-form submissions are only logged to the server console
# instead of emailed. Get a key at https://resend.com (free tier available).
RESEND_API_KEY=

# Must be a sender on a domain you've verified in Resend. Until you verify a domain,
# leave this as the Resend sandbox sender below — it works without verification.
RESEND_FROM_EMAIL="Salraza Marketing <onboarding@resend.dev>"

# Where quote-form submissions get emailed.
QUOTE_TO_EMAIL=salraza.film@gmail.com

# Your live domain once you have one (no trailing slash), used for SEO tags
# (Open Graph, sitemap, robots.txt). Falls back to localhost in development.
NEXT_PUBLIC_SITE_URL=https://salrazamarketing.com
